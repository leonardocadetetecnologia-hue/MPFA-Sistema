{
  "name": "mpfa-plataforma",
  "private": true,
  "description": "Plataforma MPFA — monólito modular (web, api, worker)",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/config",
    "packages/logger",
    "packages/contracts",
    "packages/database",
    "apps/api",
    "apps/worker",
    "apps/web"
  ],
  "scripts": {
    "build:packages": "npm run build -w @mpfa/config -w @mpfa/logger -w @mpfa/contracts -w @mpfa/database",
    "build": "npm run build:packages && npm run build -w @mpfa/api -w @mpfa/worker -w @mpfa/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "db:migrate:dev": "npm run migrate:dev -w @mpfa/database",
    "db:migrate:deploy": "npm run migrate:deploy -w @mpfa/database",
    "db:seed": "node --env-file-if-exists=.env infrastructure/scripts/seed.mjs",
    "local:up": "node --env-file-if-exists=.env infrastructure/scripts/local-up.mjs",
    "local:down": "node infrastructure/scripts/local-down.mjs",
    "local:redis": "node infrastructure/scripts/download-redis.mjs",
    "start:api": "npm run start -w @mpfa/api",
    "start:worker": "npm run start -w @mpfa/worker",
    "start:web": "npm run start -w @mpfa/web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.0",
    "@types/supertest": "^6.0.3",
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "prisma": "^6.19.3",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9",
    "typescript-eslint": "^8.70.1"
  },
  "optionalDependencies": {
    "@embedded-postgres/linux-x64": "^17.10.0-beta.17",
    "@embedded-postgres/windows-x64": "^17.10.0-beta.17"
  }
}
