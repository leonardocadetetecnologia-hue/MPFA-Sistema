# Plataforma MPFA — environment template.
# Copy to `.env` and fill in. Never commit real values. Each environment
# (local, staging, production) has its own database, Redis, secrets and URLs.

# local | staging | production
APP_ENV=local
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- API ---------------------------------------------------------------
API_PORT=3001
# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://mpfa:change-me@localhost:5432/mpfa
# redis://[:<password>@]<host>:<port>   (use rediss:// for TLS)
REDIS_URL=redis://localhost:6379
# Comma-separated browser origins allowed to call the API (empty = CORS disabled)
CORS_ORIGINS=http://localhost:3000
# Defaults to true outside production when omitted
OPENAPI_ENABLED=true
HEALTH_CHECK_TIMEOUT_MS=2000
# Directory for original message files. Not committed.
STORAGE_DIR=./var/storage
SESSION_TTL_SECONDS=28800
# Shared by the API and the worker. Empty disables the internal replay route.
WORKER_TOKEN=
# Local seed only. Refused in production. Never a real password.
SEED_PASSWORD=
# Microsoft 365. Empty means disconnected. Filling these does not mark the connection as validated.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_MAILBOX=

# --- Worker ------------------------------------------------------------
WORKER_CONCURRENCY=5

# --- Web ---------------------------------------------------------------
# Server-side URL the web app uses to reach the API (not exposed to browsers)
API_INTERNAL_URL=http://localhost:3001

# --- docker-compose only -----------------------------------------------
# Credentials used to initialise the postgres container; must match DATABASE_URL.
POSTGRES_USER=mpfa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mpfa
# Host ports published by compose (bind to 127.0.0.1 behind a reverse proxy)
PUBLISH_API_PORT=3001
PUBLISH_WEB_PORT=3000
