// Schema changes only through versioned migrations (`npm run db:migrate:dev`).
// Never use `prisma db push` outside a disposable local database.
//
// Conventions (docs/database/conventions.md):
// - UUID primary keys generated by the database (gen_random_uuid()).
// - Organizational entities carry a NOT NULL `organization_id` FK.
// - snake_case table/column names via @@map/@map.
// - Soft delete (`deleted_at`) for records with history.

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMINISTRATIVE
  LAWYER
  MANAGER
  CLIENT

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum BatchStatus {
  RECEIVED
  PROCESSING
  COMPLETED
  COMPLETED_WITH_PENDINGS
  FAILED

  @@map("batch_status")
}

enum IngestionQuality {
  VALID
  SUSPICIOUS
  INVALID

  @@map("ingestion_quality")
}

enum SourceKind {
  MSG
  EML
  PDF

  @@map("source_kind")
}

enum LinkStatus {
  PENDING
  CONFIRMED
  REJECTED

  @@map("link_status")
}

enum RouteOutcome {
  ASSIGNED
  REVIEW

  @@map("route_outcome")
}

enum WorkStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED

  @@map("work_status")
}

enum TimeEntryStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED

  @@map("time_entry_status")
}

enum TimerStatus {
  RUNNING
  PAUSED

  @@map("timer_status")
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users        User[]
  teams        Team[]
  clients      Client[]
  portfolios   Portfolio[]
  processes    LegalProcess[]
  batches      IngestionBatch[]
  rules        RoutingRule[]
  tasks        WorkTask[]
  actions      WorkAction[]
  timeEntries  TimeEntry[]
  closures     PeriodClosure[]
  auditEvents  AuditEvent[]
  mailIntents  MailIntent[]

  @@map("organizations")
}

model User {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  clientId       String?    @map("client_id") @db.Uuid
  client         Client?    @relation(fields: [clientId], references: [id])
  name           String
  email          String
  passwordHash   String     @map("password_hash")
  role           UserRole
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz(6)

  memberships    TeamMember[]
  resets         PasswordReset[]
  assignedTasks  WorkTask[]       @relation("TaskAssignee")
  actions        WorkAction[]     @relation("ActionAssignee")
  comments       Comment[]
  timeEntries    TimeEntry[]      @relation("TimeAuthor")
  approvedEntries TimeEntry[]     @relation("TimeApprover")
  timer          ActiveTimer?
  auditEvents    AuditEvent[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model PasswordReset {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("password_resets")
}

model Team {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  members        TeamMember[]
  rules          RoutingRule[]

  @@index([organizationId])
  @@map("teams")
}

model TeamMember {
  teamId String @map("team_id") @db.Uuid
  team   Team   @relation(fields: [teamId], references: [id])
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  @@id([teamId, userId])
  @@map("team_members")
}

model Client {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  active         Boolean      @default(true)
  externalId     String?      @map("external_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)

  contacts   ClientContact[]
  users      User[]
  processes  LegalProcess[]
  portfolios Portfolio[]
  rules      RoutingRule[]
  releases   PublicationRelease[]

  @@index([organizationId])
  @@map("clients")
}

model ClientContact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  client    Client   @relation(fields: [clientId], references: [id])
  name      String
  email     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([clientId])
  @@map("client_contacts")
}

model Portfolio {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  clientId       String       @map("client_id") @db.Uuid
  client         Client       @relation(fields: [clientId], references: [id])
  name           String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  processes      LegalProcess[]
  rules          RoutingRule[]

  @@index([organizationId])
  @@map("portfolios")
}

model LegalProcess {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  clientId       String?      @map("client_id") @db.Uuid
  client         Client?      @relation(fields: [clientId], references: [id])
  portfolioId    String?      @map("portfolio_id") @db.Uuid
  portfolio      Portfolio?   @relation(fields: [portfolioId], references: [id])
  cnj            String?
  title          String
  kind           String
  status         String       @default("OPEN")
  suggested      Boolean      @default(false)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)

  parties  ProcessParty[]
  lawyers  ProcessLawyer[]
  links    PublicationLink[]
  rules    RoutingRule[]
  tasks    WorkTask[]
  actions  WorkAction[]
  entries  TimeEntry[]

  @@unique([organizationId, cnj])
  @@index([organizationId])
  @@map("legal_processes")
}

model ProcessParty {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  processId String       @map("process_id") @db.Uuid
  process   LegalProcess @relation(fields: [processId], references: [id])
  role      String
  name      String

  @@index([processId])
  @@map("process_parties")
}

model ProcessLawyer {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  processId String       @map("process_id") @db.Uuid
  process   LegalProcess @relation(fields: [processId], references: [id])
  name      String
  oab       String

  @@index([processId])
  @@map("process_lawyers")
}

model IngestionBatch {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  organization     Organization @relation(fields: [organizationId], references: [id])
  status           BatchStatus  @default(RECEIVED)
  sourceKind       SourceKind   @map("source_kind")
  contentHash      String       @map("content_hash")
  seqEmail         String?      @map("seq_email")
  messageId        String?      @map("message_id")
  subject          String?
  fromAddress      String?      @map("from_address")
  parserVersion    String       @map("parser_version")
  declaredCount    Int?         @map("declared_count")
  issues           String[]
  storagePath      String       @map("storage_path")
  createdBy        String?      @map("created_by") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt       DateTime?    @map("finished_at") @db.Timestamptz(6)

  message     IngestedMessage?
  terms       SearchTerm[]
  occurrences PublicationOccurrence[]

  @@unique([organizationId, seqEmail])
  @@index([organizationId, contentHash])
  @@map("ingestion_batches")
}

model IngestedMessage {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId   String         @unique @map("batch_id") @db.Uuid
  batch     IngestionBatch @relation(fields: [batchId], references: [id])
  headers   String
  html      String
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ingested_messages")
}

model SearchTerm {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId   String         @map("batch_id") @db.Uuid
  batch     IngestionBatch @relation(fields: [batchId], references: [id])
  expression String

  @@index([batchId])
  @@map("search_terms")
}

model PublicationOccurrence {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  batchId            String           @map("batch_id") @db.Uuid
  batch              IngestionBatch   @relation(fields: [batchId], references: [id])
  identityKey        String           @map("identity_key")
  ordinal            Int?
  cnjFormatted       String?          @map("cnj_formatted")
  cnjDigits          String?          @map("cnj_digits")
  availabilityDate   DateTime?        @map("availability_date") @db.Date
  publicationDate    DateTime?        @map("publication_date") @db.Date
  processedOn        DateTime?        @map("processed_on") @db.Date
  journal            String?
  notebook           String?
  location           String?
  page               String?
  actType            String?          @map("act_type")
  isRevision         Boolean          @default(false) @map("is_revision")
  documentId         String?          @map("document_id")
  documentUrl        String?          @map("document_url")
  text               String
  html               String
  state              IngestionQuality
  issues             String[]
  parties            Json
  lawyers            Json
  intimated          Json
  ambiguous          Boolean          @default(false)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  link      PublicationLink?
  decision  RoutingDecision?
  tasks     WorkTask[]
  actions   WorkAction[]
  comments  Comment[]
  releases  PublicationRelease[]

  @@unique([batchId, identityKey])
  @@index([organizationId, cnjFormatted])
  @@map("publication_occurrences")
}

model PublicationLink {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurrenceId String                 @unique @map("occurrence_id") @db.Uuid
  occurrence   PublicationOccurrence  @relation(fields: [occurrenceId], references: [id])
  processId    String?                @map("process_id") @db.Uuid
  process      LegalProcess?          @relation(fields: [processId], references: [id])
  status       LinkStatus             @default(PENDING)
  note         String?
  decidedBy    String?                @map("decided_by") @db.Uuid
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([processId])
  @@map("publication_links")
}

model PublicationRelease {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurrenceId String                @map("occurrence_id") @db.Uuid
  occurrence   PublicationOccurrence @relation(fields: [occurrenceId], references: [id])
  clientId     String                @map("client_id") @db.Uuid
  client       Client                @relation(fields: [clientId], references: [id])
  publishedAt  DateTime              @default(now()) @map("published_at") @db.Timestamptz(6)
  publishedBy  String                @map("published_by") @db.Uuid

  @@unique([occurrenceId, clientId])
  @@map("publication_releases")
}

model RoutingRule {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id])
  name           String
  processId      String?       @map("process_id") @db.Uuid
  process        LegalProcess? @relation(fields: [processId], references: [id])
  clientId       String?       @map("client_id") @db.Uuid
  client         Client?       @relation(fields: [clientId], references: [id])
  portfolioId    String?       @map("portfolio_id") @db.Uuid
  portfolio      Portfolio?    @relation(fields: [portfolioId], references: [id])
  teamId         String?       @map("team_id") @db.Uuid
  team           Team?         @relation(fields: [teamId], references: [id])
  assigneeId     String?       @map("assignee_id") @db.Uuid
  priority       Int           @default(100)
  startsOn       DateTime?     @map("starts_on") @db.Date
  endsOn         DateTime?     @map("ends_on") @db.Date
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  decisions RoutingDecision[]

  @@index([organizationId, active, priority])
  @@map("routing_rules")
}

model RoutingDecision {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurrenceId String                @unique @map("occurrence_id") @db.Uuid
  occurrence   PublicationOccurrence @relation(fields: [occurrenceId], references: [id])
  ruleId       String?               @map("rule_id") @db.Uuid
  rule         RoutingRule?          @relation(fields: [ruleId], references: [id])
  outcome      RouteOutcome
  reason       String
  assigneeId   String?               @map("assignee_id") @db.Uuid
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("routing_decisions")
}

model WorkTask {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  organization   Organization           @relation(fields: [organizationId], references: [id])
  occurrenceId   String?                @map("occurrence_id") @db.Uuid
  occurrence     PublicationOccurrence? @relation(fields: [occurrenceId], references: [id])
  processId      String?                @map("process_id") @db.Uuid
  process        LegalProcess?          @relation(fields: [processId], references: [id])
  assigneeId     String?                @map("assignee_id") @db.Uuid
  assignee       User?                  @relation("TaskAssignee", fields: [assigneeId], references: [id])
  parentId       String?                @map("parent_id") @db.Uuid
  parent         WorkTask?              @relation("TaskTree", fields: [parentId], references: [id])
  children       WorkTask[]             @relation("TaskTree")
  title          String
  status         WorkStatus             @default(OPEN)
  priority       Int                    @default(3)
  dueOn          DateTime?              @map("due_on") @db.Date
  version        Int                    @default(0)
  origin         String                 @default("user")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  checks  ChecklistItem[]
  actions WorkAction[]
  entries TimeEntry[]

  @@index([organizationId, assigneeId, status])
  @@index([occurrenceId])
  @@map("work_tasks")
}

model ChecklistItem {
  id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId String   @map("task_id") @db.Uuid
  task   WorkTask @relation(fields: [taskId], references: [id])
  label  String
  done   Boolean  @default(false)

  @@index([taskId])
  @@map("checklist_items")
}

model WorkAction {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  organization   Organization           @relation(fields: [organizationId], references: [id])
  taskId         String?                @map("task_id") @db.Uuid
  task           WorkTask?              @relation(fields: [taskId], references: [id])
  occurrenceId   String?                @map("occurrence_id") @db.Uuid
  occurrence     PublicationOccurrence? @relation(fields: [occurrenceId], references: [id])
  processId      String?                @map("process_id") @db.Uuid
  process        LegalProcess?          @relation(fields: [processId], references: [id])
  assigneeId     String?                @map("assignee_id") @db.Uuid
  assignee       User?                  @relation("ActionAssignee", fields: [assigneeId], references: [id])
  title          String
  status         WorkStatus             @default(OPEN)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  entries TimeEntry[]

  @@index([organizationId])
  @@map("work_actions")
}

model Comment {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  occurrenceId   String?                @map("occurrence_id") @db.Uuid
  occurrence     PublicationOccurrence? @relation(fields: [occurrenceId], references: [id])
  taskId         String?                @map("task_id") @db.Uuid
  authorId       String                 @map("author_id") @db.Uuid
  author         User                   @relation(fields: [authorId], references: [id])
  body           String
  internal       Boolean                @default(true)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([occurrenceId])
  @@map("comments")
}

model TimeEntry {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  organization    Organization    @relation(fields: [organizationId], references: [id])
  userId          String          @map("user_id") @db.Uuid
  user            User            @relation("TimeAuthor", fields: [userId], references: [id])
  actionId        String?         @map("action_id") @db.Uuid
  action          WorkAction?     @relation(fields: [actionId], references: [id])
  taskId          String?         @map("task_id") @db.Uuid
  task            WorkTask?       @relation(fields: [taskId], references: [id])
  processId       String?         @map("process_id") @db.Uuid
  process         LegalProcess?   @relation(fields: [processId], references: [id])
  clientId        String?         @map("client_id") @db.Uuid
  workedMinutes   Int             @map("worked_minutes")
  billableMinutes Int             @map("billable_minutes")
  description     String
  classification  String
  status          TimeEntryStatus @default(DRAFT)
  entryDate       DateTime        @map("entry_date") @db.Date
  startedAt       DateTime?       @map("started_at") @db.Timestamptz(6)
  endedAt         DateTime?       @map("ended_at") @db.Timestamptz(6)
  version         Int             @default(0)
  returnReason    String?         @map("return_reason")
  submittedAt     DateTime?       @map("submitted_at") @db.Timestamptz(6)
  approvedAt      DateTime?       @map("approved_at") @db.Timestamptz(6)
  approvedById    String?         @map("approved_by") @db.Uuid
  approvedBy      User?           @relation("TimeApprover", fields: [approvedById], references: [id])
  overlapWarning  Boolean         @default(false) @map("overlap_warning")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  events TimeEntryEvent[]

  @@index([organizationId, userId, entryDate])
  @@map("time_entries")
}

model TimeEntryEvent {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId   String    @map("entry_id") @db.Uuid
  entry     TimeEntry @relation(fields: [entryId], references: [id])
  action    String
  actorId   String    @map("actor_id") @db.Uuid
  before    Json?
  after     Json?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entryId])
  @@map("time_entry_events")
}

model ActiveTimer {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  userId             String       @unique @map("user_id") @db.Uuid
  user               User         @relation(fields: [userId], references: [id])
  status             TimerStatus
  startedAt          DateTime     @map("started_at") @db.Timestamptz(6)
  accumulatedSeconds Int          @default(0) @map("accumulated_seconds")
  pausedAt           DateTime?    @map("paused_at") @db.Timestamptz(6)
  actionId           String?      @map("action_id") @db.Uuid
  taskId             String?      @map("task_id") @db.Uuid
  processId          String?      @map("process_id") @db.Uuid
  clientId           String?      @map("client_id") @db.Uuid
  description        String       @default("")
  classification     String       @default("atividade")

  @@map("active_timers")
}

model PeriodClosure {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  startsOn       DateTime     @map("starts_on") @db.Date
  endsOn         DateTime     @map("ends_on") @db.Date
  closedBy       String       @map("closed_by") @db.Uuid
  closedAt       DateTime     @default(now()) @map("closed_at") @db.Timestamptz(6)
  reopenedAt     DateTime?    @map("reopened_at") @db.Timestamptz(6)
  reopenedBy     String?      @map("reopened_by") @db.Uuid

  @@index([organizationId, startsOn, endsOn])
  @@map("period_closures")
}

model AuditEvent {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?      @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  actor          User?        @relation(fields: [actorUserId], references: [id])
  action         String
  resourceType   String       @map("resource_type")
  resourceId     String?      @map("resource_id")
  beforeData     Json?        @map("before_data")
  afterData      Json?        @map("after_data")
  correlationId  String?      @map("correlation_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, createdAt])
  @@map("audit_events")
}

model MailIntent {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  toAddress      String       @map("to_address")
  purpose        String
  delivered      Boolean      @default(false)
  reason         String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("mail_intents")
}
