// Schema changes only through versioned migrations (`npm run db:migrate:dev`).
// Never use `prisma db push` outside a disposable local database.
//
// Conventions for future business tables (see docs/database/conventions.md):
// - UUID primary keys generated by the database (gen_random_uuid()).
// - Organizational entities carry a NOT NULL `organization_id` FK.
// - snake_case table/column names via @@map/@map.
// - Soft delete / archive (`archived_at`, `deleted_at`) for records with history.

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
